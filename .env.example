# Configuración de la API de PhotoBackup Telemetry
NODE_ENV=development
PORT=3000

# Conexión MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=photobackup_logs
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password

# Origen permitido para CORS (producción: https://log-app.tudominio.com)
CORS_ORIGIN=*

# Rate limiting (opcional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
